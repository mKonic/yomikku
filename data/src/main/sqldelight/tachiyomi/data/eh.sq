deleteBySyncId:
DELETE FROM manga_sync WHERE sync_id = :syncId;

migrateSource:
UPDATE mangas
SET source = :newId
WHERE source = :oldId;

-- KMK -->

migrateSourceSavedSearch:
UPDATE saved_search
SET source = :newId
WHERE source = :oldId;

migrateSourceFeed:
UPDATE feed_saved_search
SET source = :newId
WHERE source = :oldId;
-- KMK <--

getChaptersByMangaIds:
SELECT * FROM chapters WHERE manga_id IN :mangaIds;


resetReaderViewerForAllManga:
UPDATE mangas
SET viewer = 0;

fixReaderViewerBackupBug:
UPDATE mangas
SET viewer = 0
WHERE viewer = -1;

addAllMangaInDatabaseToLibrary:
UPDATE mangas
SET favorite = 1;